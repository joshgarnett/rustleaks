module(
    name = "rustleaks",
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "git", version = "2.55.0")
bazel_dep(name = "llvm", version = "0.8.27")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_rust", version = "0.72.0")

single_version_override(
    module_name = "git",
    patch_strip = 1,
    patches = ["//bazel:git_macos_no_fsmonitor.patch"],
    version = "2.55.0",
)

register_toolchains("@llvm//toolchain:all")

# The Go binding tests use one pinned Go SDK. The pinned llvm toolchain
# supports cgo without a patched Go compiler only from Go 1.27. The hashes
# are the published go.dev archive hashes for the six host platforms.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    sdks = {
        "darwin_amd64": ["go1.27.4.darwin-amd64.tar.gz", "2b799377704ef12db39bd254995d5c348c9cc8d86562ca817724390e56c38f43"],
        "darwin_arm64": ["go1.27.4.darwin-arm64.tar.gz", "91a44a2b8a716600ad94a4f143e156116620db8828086a6e3602291be9bd0bb4"],
        "linux_amd64": ["go1.27.4.linux-amd64.tar.gz", "7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840"],
        "linux_arm64": ["go1.27.4.linux-arm64.tar.gz", "3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92"],
        "windows_amd64": ["go1.27.4.windows-amd64.zip", "178ab98950ac69ab25069307dc6ade79f3816e414cce95b4da166a115cde1e7e"],
        "windows_arm64": ["go1.27.4.windows-arm64.zip", "9e7a72565792b8ab370b37ac9ac109799237abacb39ff2f541c438b963c0cc64"],
    },
    version = "1.27.4",
)
use_repo(go_sdk, "go_sdk")

# The Python binding supports CPython 3.12 to 3.15. Pull requests test 3.12
# and 3.15, and the binding release dry run tests all four. rules_python
# downloads python-build-standalone interpreters. It declares no aarch64 musl
# platform, so the aarch64 musl interpreters are added here with the hashes
# from the rules_python runtime manifest.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
python.toolchain(python_version = "3.13")
python.toolchain(python_version = "3.14")
python.toolchain(python_version = "3.15")
[
    python.single_version_platform_override(
        arch = "aarch64",
        os_name = "linux",
        platform = "aarch64-unknown-linux-musl",
        python_version = version,
        sha256 = sha256,
        target_compatible_with = [
            "@platforms//cpu:aarch64",
            "@platforms//os:linux",
        ],
        target_settings = [
            "@rules_python//python/config_settings:_is_py_linux_libc_musl",
            "@rules_python//python/config_settings:_is_py_freethreaded_no",
        ],
        urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-{}+20261026-aarch64-unknown-linux-musl-install_only.tar.gz".format(version)],
    )
    for version, sha256 in [
        ("3.12.16", "4ae0f7e999d6823852a60baad66c4c2fd2e9e45c7c1d3e6b6efc305ad867c29c"),
        ("3.13.18", "2ee36197b4a57926ed6052ce1c54eae1e34a2d75c8fdaf8a52c5e7ffda00f8d4"),
        ("3.14.10", "2220e769dfae157c16cd387705bf6b9a934955d93e0b818112c2f296cc3ae50f"),
        ("3.15.2", "2bdc94b8155ee7aff6a4c4d24d23e26cf98adbee71734273865f4d8e2c41b77c"),
    ]
]

# The .rpm release package is built with the host rpmbuild. Only the
# GNU release lanes build //release/linux-packages, and they install rpm
# first; other builds never resolve this toolchain.
find_rpmbuild = use_extension("@rules_pkg//toolchains/rpm:rpmbuild_configure.bzl", "find_system_rpmbuild_bzlmod")
use_repo(find_rpmbuild, "rules_pkg_rpmbuild")
register_toolchains("@rules_pkg_rpmbuild//:all")
register_toolchains(
    "//platforms:linux_aarch64_musl_test_toolchain",
    "//platforms:linux_x86_64_musl_test_toolchain",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# rules_rust intentionally maps Linux GNU and musl triples to the same default
# CPU and OS constraints. Keep musl out of the default repository set and add
# it only through explicitly constrained sets so the libc constraint selects
# the requested Rust standard library.
rust.repository_set(
    edition = "2024",
    exec_triple = "aarch64-apple-darwin",
    name = "rust_musl_macos_aarch64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_macos_aarch64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    edition = "2024",
    exec_triple = "x86_64-apple-darwin",
    name = "rust_musl_macos_x86_64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_macos_x86_64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    edition = "2024",
    exec_triple = "aarch64-unknown-linux-gnu",
    name = "rust_musl_linux_aarch64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_linux_aarch64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    edition = "2024",
    exec_triple = "x86_64-unknown-linux-gnu",
    name = "rust_musl_linux_x86_64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_linux_x86_64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    edition = "2024",
    exec_triple = "aarch64-pc-windows-msvc",
    name = "rust_musl_windows_aarch64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_windows_aarch64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    edition = "2024",
    exec_triple = "x86_64-pc-windows-msvc",
    name = "rust_musl_windows_x86_64",
    target_compatible_with = ["@platforms//cpu:aarch64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "aarch64-unknown-linux-musl",
    versions = ["1.95.0"],
)
rust.repository_set(
    name = "rust_musl_windows_x86_64",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux", "//platforms:musl"],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.95.0"],
)
use_repo(
    rust,
    "rust_musl_linux_aarch64__aarch64-unknown-linux-musl__stable",
    "rust_musl_linux_aarch64__x86_64-unknown-linux-musl__stable",
    "rust_musl_linux_x86_64__aarch64-unknown-linux-musl__stable",
    "rust_musl_linux_x86_64__x86_64-unknown-linux-musl__stable",
    "rust_musl_macos_aarch64__aarch64-unknown-linux-musl__stable",
    "rust_musl_macos_aarch64__x86_64-unknown-linux-musl__stable",
    "rust_musl_macos_x86_64__aarch64-unknown-linux-musl__stable",
    "rust_musl_macos_x86_64__x86_64-unknown-linux-musl__stable",
    "rust_toolchains",
    # rules_rust compacts Windows repository names. Keep semantic aliases at
    # the root boundary so build configurations do not depend on those names.
    rust_musl_windows_aarch64_aarch64 = "rw-909678106",
    rust_musl_windows_aarch64_x86_64 = "rw-1263212488",
    rust_musl_windows_x86_64_aarch64 = "rw-139904074",
    rust_musl_windows_x86_64_x86_64 = "rw-872401912",
)
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.render_config(
    platforms_template = "@@//platforms:{triple}",
    regen_command = "just deps-repin",
    repositories = ["crates"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    isolated = True,
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "crates")
