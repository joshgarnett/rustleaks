{
 "schema": "rustleaks-comparison-workloads-v1",
 "set": "public-repos",
 "classes": {
  "small": "packed history under about 50 MB",
  "medium": "packed history from about 50 MB to 1 GB",
  "large": "packed history above 1 GB"
 },
 "fetch_procedure": [
  "git init --quiet repo",
  "git -C repo fetch --no-tags --quiet [--depth 1 when only dir mode is fetched] URL REF",
  "check that FETCH_HEAD^{commit} is the pinned commit",
  "git -C repo update-ref refs/heads/main COMMIT",
  "git -C repo symbolic-ref HEAD refs/heads/main",
  "write tree/ from git ls-tree -r -z -l --full-tree COMMIT and git cat-file --batch"
 ],
 "fetch_command": "cargo xtask compare-workloads fetch --cache DIR [--only ID,...] [--mode dir|git|both] [--allow-large]",
 "notes": "Repositories are used for speed only. They carry no labels, and real findings in them are not recorded in this repository. The git path holds only history reachable from the pinned commit, with one ref and no worktree checkout. The dir path holds the exact blob bytes of that commit.",
