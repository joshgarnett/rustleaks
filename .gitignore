# Rust build output
/target/
**/target/

# Fuzzing runtime output. Committed seeds live in fuzz/seeds.
**/fuzz/artifacts/
**/fuzz/corpus/

# Python bytecode from running the binding outside Bazel
__pycache__/
# A native library copied into the Python package to try it from a checkout
/bindings/python/src/rustleaks/_native/

# Coverage and profiling output
*.profraw
*.profdata

# Local environment and secrets
.env
.env.*
!testdata/fixtures/**/.env*
.direnv/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local scratch and failed patch files
/.cache/
/.tmp/
/tmp/
/bazel-*
*.orig
*.rej

# Release package input written by cargo xtask release-artifact package-input
/release/linux-packages/input/
