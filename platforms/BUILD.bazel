package(default_visibility = ["//visibility:public"])

filegroup(
    name = "build_contract_files",
    srcs = glob(["**"]),
)

constraint_setting(name = "libc")

constraint_value(
    name = "gnu",
    constraint_setting = ":libc",
)

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

constraint_value(
    name = "msvc",
    constraint_setting = ":libc",
)

platform(
    name = "linux_x86_64_gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":gnu",
    ],
)

platform(
    name = "linux_aarch64_gnu",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":gnu",
    ],
)

platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":musl",
    ],
)

platform(
    name = "linux_aarch64_musl",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":musl",
    ],
)

# The musl platforms above keep the LLVM C toolchain's default libc, so Rust
# executables link as static PIE with Rust's own musl objects. Code that
# compiles C for musl, such as cgo in the Go binding tests, needs the LLVM
# toolchain's musl mode. These platforms select it, with PIE off because Go
# links executables with -no-pie. Only the binding tests use them, through
# //bazel:musl_c.bzl.
platform(
    name = "linux_x86_64_musl_c",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
    ],
    parents = [":linux_x86_64_musl"],
)

platform(
    name = "linux_aarch64_musl_c",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@llvm//constraints/pie:off",
    ],
    parents = [":linux_aarch64_musl"],
)

config_setting(
    name = "musl_any_libc",
    constraint_values = [":musl"],
)

config_setting(
    name = "musl_c_libc",
    constraint_values = [
        ":musl",
        "@llvm//constraints/libc:musl",
    ],
)

# Musl executables run natively on their matching Linux hosts, but host-side
# build tools and proc macros must use the GNU execution toolchain.
toolchain(
    name = "linux_x86_64_musl_test_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":gnu",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

toolchain(
    name = "linux_aarch64_musl_test_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":gnu",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "windows_x86_64_msvc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        ":msvc",
    ],
)

platform(
    name = "windows_aarch64_msvc",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:windows",
        ":msvc",
    ],
)

config_setting(
    name = "x86_64-unknown-linux-gnu",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux", ":gnu"],
)
config_setting(
    name = "aarch64-unknown-linux-gnu",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:linux", ":gnu"],
)
config_setting(
    name = "x86_64-unknown-linux-musl",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux", ":musl"],
)
config_setting(
    name = "aarch64-unknown-linux-musl",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:linux", ":musl"],
)
config_setting(
    name = "x86_64-apple-darwin",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:macos"],
)
config_setting(
    name = "aarch64-apple-darwin",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:macos"],
)
config_setting(
    name = "x86_64-pc-windows-msvc",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:windows", ":msvc"],
)
config_setting(
    name = "aarch64-pc-windows-msvc",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:windows", ":msvc"],
)
