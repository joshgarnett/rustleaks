    name = "format",
    targets = _RUST_TARGETS,
    transitive = True,
)

rust_clippy_test(
    name = "clippy",
    targets = _RUST_TARGETS,
    transitive = True,
)

test_suite(
    name = "parity",
    tests = [
        "//crates/rustleaks-cli:parity_tests",
        "//crates/rustleaks-core:parity_tests",
        "//crates/rustleaks-report:parity_tests",
        "//crates/rustleaks-sources:parity_tests",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test",
    tests = [
        "//crates/rustleaks-bzip2:rustleaks_bzip2_doc_test",
        "//crates/rustleaks-bzip2:rustleaks_bzip2_unit_test",
