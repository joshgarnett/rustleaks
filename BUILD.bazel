load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//bazel:platform_matrix.bzl", "platform_build")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "NOTICE",
    "cargo-bazel-lock.json",
])

filegroup(
    name = "workspace_files",
    srcs = glob([
        "*.md",
        "*.toml",
        "docs/**",
    ]) + [
        "Cargo.lock",
        "LICENSE",
        "NOTICE",
        "cargo-bazel-lock.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "build_contract_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "BUILD.bazel",
        "Cargo.lock",
        "Cargo.toml",
        "MODULE.bazel",
        "MODULE.bazel.lock",
        "cargo-bazel-lock.json",
        "justfile",
        "rust-toolchain.toml",
        "//bazel:build_contract_files",
        "//crates/rustleaks-bzip2:build_contract_files",
        "//crates/rustleaks-cli:build_contract_files",
        "//crates/rustleaks-compat:build_contract_files",
        "//crates/rustleaks-compcol:build_contract_files",
        "//crates/rustleaks-core:build_contract_files",
        "//crates/rustleaks-rar-codec:build_contract_files",
        "//crates/rustleaks-report:build_contract_files",
        "//crates/rustleaks-sevenz:build_contract_files",
        "//crates/rustleaks-sources:build_contract_files",
        "//crates/xtask:build_contract_files",
        "//platforms:build_contract_files",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "libraries",
    srcs = [
        "//crates/rustleaks-bzip2:feature_profiles",
        "//crates/rustleaks-bzip2:rustleaks_bzip2",
        "//crates/rustleaks-compcol:compcol",
        "//crates/rustleaks-compcol:feature_profiles",
        "//crates/rustleaks-compat:rustleaks_compat",
        "//crates/rustleaks-core:rustleaks_core",
        "//crates/rustleaks-rar-codec:rustleaks_rar_codec",
        "//crates/rustleaks-report:rustleaks_report",
        "//crates/rustleaks-sevenz:feature_profiles",
        "//crates/rustleaks-sevenz:rustleaks_sevenz",
        "//crates/rustleaks-sources:feature_profiles",
        "//crates/rustleaks-sources:rustleaks_sources",
        "//crates/rustleaks-sources:rustleaks_sources_archives",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "build",
    srcs = [
        ":libraries",
        "//crates/rustleaks-cli:rustleaks",
        "//crates/rustleaks-cli:rustleaks_cli",
        "//crates/rustleaks-compat:rustleaks_perf",
        "//crates/rustleaks-sources:panic_abort_policy",
        "//crates/xtask:xtask",
    ],
    visibility = ["//visibility:public"],
)

[
    platform_build(
        name = "build_" + name,
        platform = "//platforms:" + name,
        target = ":libraries",
    )
    for name in [
        "linux_x86_64_gnu",
        "linux_aarch64_gnu",
        "linux_x86_64_musl",
        "linux_aarch64_musl",
        "macos_x86_64",
        "macos_aarch64",
        "windows_x86_64_msvc",
        "windows_aarch64_msvc",
    ]
]

filegroup(
    name = "platform_matrix",
    srcs = [
        ":build_linux_x86_64_gnu",
        ":build_linux_aarch64_gnu",
        ":build_linux_x86_64_musl",
        ":build_linux_aarch64_musl",
        ":build_macos_x86_64",
        ":build_macos_aarch64",
        ":build_windows_x86_64_msvc",
        ":build_windows_aarch64_msvc",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "docs",
    srcs = [
        "//crates/rustleaks-bzip2:rustleaks_bzip2_docs",
        "//crates/rustleaks-cli:rustleaks_cli_docs",
        "//crates/rustleaks-compat:rustleaks_compat_docs",
        "//crates/rustleaks-compcol:compcol_docs",
        "//crates/rustleaks-core:rustleaks_core_docs",
        "//crates/rustleaks-rar-codec:rustleaks_rar_codec_docs",
        "//crates/rustleaks-report:rustleaks_report_docs",
        "//crates/rustleaks-sevenz:rustleaks_sevenz_docs",
        "//crates/rustleaks-sources:rustleaks_sources_docs",
        "//crates/rustleaks-sources:rustleaks_sources_archives_docs",
    ],
    visibility = ["//visibility:public"],
)

