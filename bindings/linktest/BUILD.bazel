# Links the Rustleaks static library and a second Rust static library into
# one cgo program. Two Rust static libraries each carry a copy of the Rust
# standard library, so this checks that the release archive does not cause
# duplicate symbol errors in a Go program that already uses Rust.

load("@rules_go//go:def.bzl", "go_test")
load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//bazel:musl_c.bzl", "musl_c_test")

rust_static_library(
    name = "other_static",
    srcs = ["other.rs"],
    crate_name = "other_rust",
    crate_root = "other.rs",
    edition = "2024",
)

go_test(
    name = "link_test",
    size = "small",
    srcs = ["link_test.go"],
    cdeps = [
        ":other_static",
        "//crates/rustleaks-ffi:rustleaks_ffi_static",
    ],
    cgo = True,
    importpath = "github.com/joshgarnett/rustleaks/bindings/linktest",
    pure = "off",
    target_compatible_with = select({
        "//platforms:musl_c_libc": [],
        "//platforms:musl_any_libc": ["@platforms//:incompatible"],
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

musl_c_test(
    name = "link_musl_test",
    size = "small",
    target_compatible_with = ["//platforms:musl"],
    test = ":link_test",
)

test_suite(
    name = "all_tests",
    tests = [
        ":link_musl_test",
        ":link_test",
    ],
    visibility = ["//visibility:public"],
)
