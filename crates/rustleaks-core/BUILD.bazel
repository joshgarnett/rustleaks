load("//bazel:rust_crate.bzl", "rustleaks_build_contract_files", "rustleaks_integration_test", "rustleaks_library")

exports_files(["Cargo.toml"])
rustleaks_build_contract_files()

filegroup(
    name = "campaign_profile_support",
    srcs = ["tests/support/campaign_profile.rs"],
    visibility = ["//visibility:public"],
)

rustleaks_library(
    name = "rustleaks_core",
    compile_data = glob(["default/**"]) + ["//compat:parity_corpora"],
    crate_name = "rustleaks_core",
    data = ["//compat:all"],
    edition = "2024",
    unit_test_tags = ["exclusive"],
    version = "0.1.0-alpha.8",
)

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        data = ["//compat:all"],
        deps = [":rustleaks_core"],
    )
    for test in [
        "native_policy",
        "native_rules",
        "triage",

        "allowlist",
        "composite_corpus",
        "config",
        "controlled_scan",
        "default_rule_corpus",
        "decoded_locations",
        "detect_corpus",
        "engine",
        "model",
        "location_lookup",
        "scan_semantics",
        "session_corpus",
    ]
]

rustleaks_integration_test(
    name = "security_stress_test",
    src = "tests/security_stress.rs",
    deps = [":rustleaks_core"],
    srcs = [":campaign_profile_support"],
)

test_suite(
    name = "parity_tests",
    tests = [
        ":allowlist_test",
        ":composite_corpus_test",
        ":config_test",
        ":default_rule_corpus_test",
        ":detect_corpus_test",
        ":rustleaks_core_unit_test",
        ":session_corpus_test",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all_tests",
    tests = [
        ":native_policy_test",
        ":native_rules_test",
        ":triage_test",

        ":security_stress_test",
        ":allowlist_test",
        ":composite_corpus_test",
        ":config_test",
        ":controlled_scan_test",
        ":default_rule_corpus_test",
        ":decoded_locations_test",
        ":detect_corpus_test",
        ":engine_test",
        ":model_test",
        ":location_lookup_test",
        ":rustleaks_core_doc_test",
        ":rustleaks_core_unit_test",
        ":scan_semantics_test",
        ":session_corpus_test",
    ],
    visibility = ["//visibility:public"],
)
