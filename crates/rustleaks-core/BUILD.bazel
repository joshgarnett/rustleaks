load("//bazel:rust_crate.bzl", "rustleaks_build_contract_files", "rustleaks_integration_test", "rustleaks_library")

exports_files(["Cargo.toml"])
rustleaks_build_contract_files()

filegroup(
    name = "campaign_profile_support",
    srcs = ["tests/support/campaign_profile.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pack_case_support",
    srcs = [
        "tests/support/connection_cases.rs",
        "tests/support/contextual_delta_cases.rs",
        "tests/support/extra_rule_cases.rs",
        "tests/support/provider_rule_cases.rs",
        "tests/support/shared_delta_cases.rs",
    ],
)

rustleaks_library(
    name = "rustleaks_core",
    compile_data = glob(["default/**", "data/**"]) + ["//compat:parity_corpora"],
    crate_name = "rustleaks_core",
    data = ["//compat:all"],
    edition = "2024",
    unit_test_tags = ["exclusive"],
    version = "0.1.0-alpha.9",
)

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        data = ["//compat:all"],
        deps = [":rustleaks_core"],
        srcs = [":pack_case_support"],
    )
    for test in [
        "native_policy",
        "native_predicates",
        "native_rules",
        "provider_rules",
        "shared_rule_deltas",
        "contextual_rule_deltas",
        "connection_rules",
        "triage",

        "allowlist",
        "composite_corpus",
        "config",
        "controlled_scan",
        "default_rule_corpus",
        "decoded_locations",
        "detect_corpus",
        "engine",
        "generic_recall",
        "language_fixtures",
        "model",
        "location_lookup",
        "scan_semantics",
        "session_corpus",
    ]
]

rustleaks_integration_test(
    name = "security_stress_test",
    src = "tests/security_stress.rs",
    deps = [":rustleaks_core"],
    srcs = [":campaign_profile_support"],
)

rustleaks_integration_test(
    name = "additional_coverage_test",
    src = "tests/additional_coverage.rs",
    compile_data = ["tests/support/additional_coverage.json"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "format_coverage_test",
    src = "tests/format_coverage.rs",
    compile_data = ["tests/support/format_coverage.json"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "special_coverage_test",
    src = "tests/special_coverage.rs",
    compile_data = ["tests/support/special_coverage.json"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "association_coverage_test",
    src = "tests/association_coverage.rs",
    compile_data = ["tests/support/association_coverage.json"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "remaining_verified_rules_test",
    src = "tests/remaining_verified_rules.rs",
    compile_data = ["tests/support/remaining_verified_rules.json"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "default_rule_cases_test",
    src = "tests/default_rule_cases.rs",
    data = ["//compat:all"],
    deps = [":rustleaks_core"],
)

rustleaks_integration_test(
    name = "rule_precedence_test",
    src = "tests/rule_precedence.rs",
    compile_data = [
        "tests/support/additional_coverage.json",
        "tests/support/association_coverage.json",
        "tests/support/format_coverage.json",
        "tests/support/remaining_verified_rules.json",
        "tests/support/special_coverage.json",
    ],
    data = ["//compat:all"],
    deps = [":rustleaks_core"],
    srcs = [":pack_case_support"],
)

test_suite(
    name = "parity_tests",
    tests = [
        ":allowlist_test",
        ":composite_corpus_test",
        ":config_test",
        ":default_rule_corpus_test",
        ":detect_corpus_test",
        ":rustleaks_core_unit_test",
        ":session_corpus_test",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all_tests",
    tests = [
        ":native_policy_test",
        ":native_predicates_test",
        ":native_rules_test",
        ":provider_rules_test",
        ":additional_coverage_test",
        ":format_coverage_test",
        ":special_coverage_test",
        ":association_coverage_test",
        ":remaining_verified_rules_test",
        ":shared_rule_deltas_test",
        ":contextual_rule_deltas_test",
        ":connection_rules_test",
        ":triage_test",

        ":security_stress_test",
        ":default_rule_cases_test",
        ":rule_precedence_test",
        ":allowlist_test",
        ":composite_corpus_test",
        ":config_test",
        ":controlled_scan_test",
        ":default_rule_corpus_test",
        ":decoded_locations_test",
        ":detect_corpus_test",
        ":engine_test",
        ":generic_recall_test",
        ":language_fixtures_test",
        ":model_test",
        ":location_lookup_test",
        ":rustleaks_core_doc_test",
        ":rustleaks_core_unit_test",
        ":scan_semantics_test",
        ":session_corpus_test",
    ],
    visibility = ["//visibility:public"],
)
