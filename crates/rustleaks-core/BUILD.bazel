load("//bazel:rust_crate.bzl", "rustleaks_build_contract_files", "rustleaks_integration_test", "rustleaks_library")

exports_files(["Cargo.toml"])
rustleaks_build_contract_files()

filegroup(
    name = "fuzz_profile_support",
    srcs = ["tests/support/fuzz_profile.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "pack_case_support",
    srcs = [
        "tests/support/connection_cases.rs",
        "tests/support/contextual_delta_cases.rs",
        "tests/support/extra_rule_cases.rs",
        "tests/support/provider_rule_cases.rs",
        "tests/support/shared_delta_cases.rs",
    ],
)

filegroup(
    name = "native_harness_support",
    srcs = ["tests/support/native_harness.rs"],
)

filegroup(
    name = "corpus_support",
    srcs = ["tests/support/corpus.rs"],
)

rustleaks_library(
    name = "rustleaks_core",
    compile_data = glob(["default/**", "data/**"]) + [
        "README.md",
        "//testdata:corpora",
    ],
    crate_name = "rustleaks_core",
    data = ["//testdata:all"],
    edition = "2024",
    unit_test_tags = ["exclusive"],
)

# Tests that need no support module and no file under testdata/.
_PLAIN_TESTS = [
    "controlled_scan",
    "decoded_locations",
    "default_rules",
    "engine",
    "generic_recall",
    "language_fixtures",
    "location_lookup",
    "model",
    "native_policy",
    "native_predicates",
    "rule_overlaps",
    "scan_semantics",
    "triage",
]

# Tests that include the rule-pack case modules.
_PACK_TESTS = [
    "connection_rules",
    "contextual_rule_deltas",
    "native_rules",
    "provider_rules",
    "shared_rule_deltas",
]

# Tests that read files under testdata/.
_TESTDATA_TESTS = [
    "config",
    "default_rule_cases",
    "default_rule_corpus",
]

# Tests that read a corpus under testdata/ with the shared corpus module.
_CORPUS_TESTS = [
    "allowlist",
    "composite_corpus",
    "detect_corpus",
    "session_corpus",
]

# Rule coverage tests. Each one compiles in tests/support/<test>.json.
_COVERAGE_TESTS = [
    "additional_coverage",
    "association_coverage",
    "format_coverage",
    "remaining_verified_rules",
    "special_coverage",
]

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        deps = [":rustleaks_core"],
    )
    for test in _PLAIN_TESTS
]

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        deps = [":rustleaks_core"],
        srcs = [":pack_case_support"],
    )
    for test in _PACK_TESTS
]

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        data = ["//testdata:all"],
        deps = [":rustleaks_core"],
    )
    for test in _TESTDATA_TESTS
]

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        data = ["//testdata:all"],
        deps = [":rustleaks_core"],
        srcs = [":corpus_support"],
    )
    for test in _CORPUS_TESTS
]

[
    rustleaks_integration_test(
        name = test + "_test",
        src = "tests/" + test + ".rs",
        compile_data = ["tests/support/" + test + ".json"],
        deps = [":rustleaks_core"],
        srcs = [":native_harness_support"],
    )
    for test in _COVERAGE_TESTS
]

rustleaks_integration_test(
    name = "security_stress_test",
    src = "tests/security_stress.rs",
    deps = [":rustleaks_core"],
    srcs = [":fuzz_profile_support"],
)

rustleaks_integration_test(
    name = "rule_precedence_test",
    src = "tests/rule_precedence.rs",
    compile_data = ["tests/support/" + data + ".json" for data in [
        "additional_coverage",
        "association_coverage",
        "format_coverage",
        "remaining_verified_rules",
        "special_coverage",
    ]],
    data = ["//testdata:all"],
    deps = [":rustleaks_core"],
    srcs = [":pack_case_support"],
)

test_suite(
    name = "all_tests",
    tests = [
        ":" + test + "_test"
        for test in _PLAIN_TESTS + _PACK_TESTS + _TESTDATA_TESTS + _CORPUS_TESTS + _COVERAGE_TESTS
    ] + [
        ":rule_precedence_test",
        ":rustleaks_core_doc_test",
        ":rustleaks_core_unit_test",
        ":security_stress_test",
    ],
    visibility = ["//visibility:public"],
)
