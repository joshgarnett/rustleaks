load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//bazel:rust_crate.bzl", "RUSTLEAKS_VERSION", "rustleaks_build_contract_files", "rustleaks_library")

exports_files(["Cargo.toml"])
rustleaks_build_contract_files()

_DEPS = [
    "//crates/rustleaks-core:rustleaks_core",
    "//crates/rustleaks-report:rustleaks_report",
    "//crates/rustleaks-sources:rustleaks_sources",
]

rustleaks_library(
    name = "rustleaks_eval",
    crate_name = "rustleaks_eval",
    data = ["//testdata:all"],
    deps = ["//crates/rustleaks-core:rustleaks_core"],
    docs = False,
    edition = "2024",
    srcs = glob(["src/lib.rs", "src/evaluation/**/*.rs"]),
)

rust_binary(
    name = "rustleaks_perf",
    aliases = aliases(),
    crate_name = "rustleaks_perf",
    crate_root = "src/bin/rustleaks-perf.rs",
    data = ["//testdata:all"],
    deps = all_crate_deps(normal = True) + _DEPS,
    edition = "2024",
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/rustleaks-eval",
        "CARGO_PKG_VERSION": RUSTLEAKS_VERSION,
    },
    srcs = ["src/bin/rustleaks-perf.rs"] + glob(["src/perf/*.rs"]),
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "rustleaks_quality",
    aliases = aliases(),
    crate_name = "rustleaks_quality",
    crate_root = "src/bin/rustleaks-quality.rs",
    data = ["//testdata:all"],
    deps = all_crate_deps(normal = True) + [":rustleaks_eval"],
    edition = "2024",
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/rustleaks-eval",
        "CARGO_PKG_VERSION": RUSTLEAKS_VERSION,
    },
    srcs = ["src/bin/rustleaks-quality.rs"],
    visibility = ["//visibility:public"],
)

# Writes the core findings that the Go and Python differential tests
# compare with. See :binding_reference.
rust_binary(
    name = "rustleaks_binding_reference",
    aliases = aliases(),
    crate_name = "rustleaks_binding_reference",
    crate_root = "src/bin/rustleaks-binding-reference.rs",
    deps = all_crate_deps(normal = True) + ["//crates/rustleaks-core:rustleaks_core"],
    edition = "2024",
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/rustleaks-eval",
        "CARGO_PKG_VERSION": RUSTLEAKS_VERSION,
    },
    srcs = ["src/bin/rustleaks-binding-reference.rs"],
    visibility = ["//visibility:public"],
)

# The files that the Go and Python differential tests scan: every fixture
# file, which includes binary files and files without a final line break,
# and a pinned list of text files.
filegroup(
    name = "binding_reference_files",
    srcs = [
        "//testdata:bindings/cases.json",
        "//testdata:fixtures",
        "//testdata:quality-corpus/README.md",
        "//testdata:quality-corpus/cases-v1.json",
        "//testdata:README.md",
    ],
    visibility = ["//visibility:public"],
)

# Runs the reference tool at build time of the binding tests. The outputs
# are never checked in. The samples file is the generator corpus inputs, one
# after another; with it the set reaches 216 of the 515 built-in rules.
run_binary(
    name = "binding_reference",
    srcs = [
        ":binding_reference_files",
        "//testdata:generator-corpus/samples-v1.jsonl",
    ],
    outs = [
        "binding-reference.json",
        "binding-samples.txt",
    ],
    args = [
        "$(execpath binding-reference.json)",
        "$(execpath //testdata:generator-corpus/samples-v1.jsonl)",
        "$(execpath binding-samples.txt)",
        "crates/rustleaks-eval/binding-samples.txt",
        "$(execpaths :binding_reference_files)",
    ],
    tool = ":rustleaks_binding_reference",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "rustleaks_cli_fixture",
    crate_name = "rustleaks_cli_fixture",
    crate_root = "src/bin/rustleaks-cli-fixture.rs",
    edition = "2024",
    srcs = ["src/bin/rustleaks-cli-fixture.rs"],
    visibility = ["//visibility:public"],
)

_PERF_GIT_DATA = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["//bazel:git"],
})

_PERF_TEST_ENV = select({
    "@platforms//os:windows": {
        "RUSTLEAKS_PERF_CLI_RUNFILE": "$(rlocationpath //crates/rustleaks-cli:rustleaks)",
        "RUSTLEAKS_PERF_GIT_RUNFILE": "git",
    },
    "//conditions:default": {
        "RUSTLEAKS_PERF_CLI_RUNFILE": "$(rlocationpath //crates/rustleaks-cli:rustleaks)",
        "RUSTLEAKS_PERF_GIT_RUNFILE": "$(rlocationpath //bazel:git)",
    },
})

rust_test(
    name = "rustleaks_perf_test",
    aliases = aliases(normal = True, normal_dev = True),
    crate = ":rustleaks_perf",
    data = [
        "//testdata:all",
        "//crates/rustleaks-cli:rustleaks",
    ] + _PERF_GIT_DATA,
    env = _PERF_TEST_ENV,
    deps = all_crate_deps(normal = True, normal_dev = True) + _DEPS,
    rustc_env = {
        "CARGO_MANIFEST_DIR": "crates/rustleaks-eval",
        "CARGO_PKG_VERSION": RUSTLEAKS_VERSION,
    },
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all_tests",
    tests = [
        ":rustleaks_eval_unit_test",
        ":rustleaks_perf_test",
    ],
    visibility = ["//visibility:public"],
)
