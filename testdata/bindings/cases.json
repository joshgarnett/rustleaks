            "start_line": 1,
            "end_line": 1,
            "start_column": 1,
            "end_column": 9,
            "secret_range": [5, 9]
          }
        ]
      }
    },
    {
      "name": "nul-and-invalid-utf8-bytes",
      "engine": {"config": "configs/marker.toml", "rules": null},
      "scan": {"input": [{"hex": "00ff"}, "MARK-ABCD", {"hex": "fe0a"}]},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "synthetic-marker",
            "secret": ["ABCD"],
            "match": ["MARK-ABCD"],
            "line": [{"hex": "00ff"}, "MARK-ABCD", {"hex": "fe"}],
            "start_line": 1,
            "end_line": 1,
            "start_column": 3,
            "end_column": 11,
            "secret_range": [7, 11]
          }
        ]
      }
