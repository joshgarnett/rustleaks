{
  "cases": [
    {
      "name": "empty-input-with-a-path-rule",
      "engine": {"config": null, "rules": null},
      "scan": {"input": [], "path": "certs/site.p12"},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "pkcs12-file",
            "secret": [],
            "match": ["file detected: certs/site.p12"],
            "line": [],
            "start_line": 0,
            "end_line": 0,
            "start_column": 0,
            "end_column": 0,
            "secret_range": null
          }
        ]
      }
    },
    {
      "name": "empty-input-without-a-path",
      "engine": {"config": null, "rules": null},
      "scan": {"input": []},
      "expect": {"error": null, "findings": []}
    },
    {
      "name": "path-rule-needs-a-matching-path",
      "engine": {"config": null, "rules": null},
      "scan": {"input": [], "path": "certs/site.pem"},
      "expect": {"error": null, "findings": []}
    },
    {
      "name": "builtin-rule-on-the-first-line",
      "engine": {"config": null, "rules": null},
      "scan": {"input": ["AKIA", "LALEMEL33243OLIB\n"]},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "aws-access-token",
            "secret": ["AKIA", "LALEMEL33243OLIB"],
            "match": ["AKIA", "LALEMEL33243OLIB"],
            "line": ["AKIA", "LALEMEL33243OLIB"],
            "start_line": 1,
            "end_line": 1,
            "start_column": 1,
            "end_column": 20,
            "secret_range": [0, 20]
          }
        ]
      }
    },
    {
      "name": "match-on-the-first-line",
      "engine": {"config": "configs/marker.toml", "rules": null},
      "scan": {"input": ["a MARK-ABCD b\n"], "path": "config/app.env"},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "synthetic-marker",
            "secret": ["ABCD"],
            "match": ["MARK-ABCD"],
            "line": ["a MARK-ABCD b"],
            "start_line": 1,
            "end_line": 1,
            "start_column": 3,
            "end_column": 11,
            "secret_range": [7, 11]
          }
        ]
      }
    },
    {
      "name": "matches-on-later-lines",
      "engine": {"config": "configs/marker.toml", "rules": null},
      "scan": {"input": ["x\n", "MARK-ABCD\n", "  MARK-EFGH\n"]},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "synthetic-marker",
            "secret": ["ABCD"],
            "match": ["MARK-ABCD"],
            "line": ["\nMARK-ABCD"],
            "start_line": 2,
            "end_line": 2,
            "start_column": 2,
            "end_column": 10,
            "secret_range": [7, 11]
          },
          {
            "rule_id": "synthetic-marker",
            "secret": ["EFGH"],
            "match": ["MARK-EFGH"],
            "line": ["\n  MARK-EFGH"],
            "start_line": 3,
            "end_line": 3,
            "start_column": 4,
            "end_column": 12,
            "secret_range": [19, 23]
          }
        ]
      }
    },
    {
      "name": "unterminated-last-line",
      "engine": {"config": "configs/marker.toml", "rules": null},
      "scan": {"input": ["x\n", "MARK-ABCD"]},
      "expect": {
        "error": null,
        "findings": [
          {
            "rule_id": "synthetic-marker",
            "secret": ["ABCD"],
            "match": ["MARK-ABCD"],
            "line": ["x\n", "MARK-ABCD"],
            "start_line": 2,
            "end_line": 2,
            "start_column": 2,
            "end_column": 10,
            "secret_range": [7, 11]
          }
        ]
      }
    },
    {
      "name": "input-without-a-line-end",
      "engine": {"config": "configs/marker.toml", "rules": null},
