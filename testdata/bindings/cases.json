            "end_line": 2,
            "start_column": 2,
            "end_column": 10,
            "secret_range": [8, 12]
          }
        ]
      }
    },
    {
      "name": "match-over-several-lines",
      "engine": {"config": "configs/block.toml", "rules": null},
      "scan": {"input": ["x\n", "BEGIN\n", "data\n", "END\n"]},
