load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")
load(":execution_tool.bzl", "execution_tool")

execution_tool(
    name = "git",
    tool = "@git//:git",
    visibility = ["//visibility:public"],
)

# rules_rust's stable-channel doctest runner executes from runfiles. Wrapping
# the selected LLVM builtins archive in CcInfo lets it remap that generated
# archive from the Bazel execroot into the test runfiles tree.
cc_import(
    name = "compiler_rt_builtins",
    static_library = "@llvm//runtimes/compiler-rt:clang_rt.builtins.static",
    visibility = ["//visibility:public"],
)

# rustdoc compiles examples as standalone programs. The hermetic Linux linker
# disables its implicit unwind library, so the doctest runfiles must carry and
# link the selected LLVM unwind archive explicitly.
cc_import(
    name = "llvm_unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
    visibility = ["//visibility:public"],
)

# The hermetic musl toolchain links musl's C library statically. A shared
# library that a dynamic musl process loads, such as the Python binding
# library, must instead use that process's C library. Linking against the
# LLVM module's shared musl libc.so records its soname, libc.so, as a
# DT_NEEDED entry, which the musl loader resolves to itself. The copy has its
# own file name because rules_rust searches the Rust self-contained folder,
# which holds a static libc.a, before any dependency folder.
copy_file(
    name = "musl_libc_shared_file",
    src = "@llvm//runtimes/musl:musl_libc.so",
    out = "musl/librustleaks_musl_c.so",
    allow_symlink = True,
    target_compatible_with = ["//platforms:musl"],
)

cc_import(
    name = "musl_libc_shared",
    shared_library = ":musl_libc_shared_file",
    target_compatible_with = ["//platforms:musl"],
    visibility = ["//visibility:public"],
)

rust_proc_macro(
    name = "doctest_path_mapper",
    crate_name = "rustleaks_doctest_path_mapper",
    crate_root = "doctest_path_mapper.rs",
    edition = "2024",
    srcs = ["doctest_path_mapper.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "build_contract_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
