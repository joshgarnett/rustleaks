load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")
load(":execution_tool.bzl", "execution_tool")

exports_files([
    "execution_tool.bzl",
    "platform_matrix.bzl",
    "rust_crate.bzl",
])

execution_tool(
    name = "git",
    tool = "@git//:git",
    visibility = ["//visibility:public"],
)

# rules_rust's stable-channel doctest runner executes from runfiles. Wrapping
# the selected LLVM builtins archive in CcInfo lets it remap that generated
# archive from the Bazel execroot into the test runfiles tree.
cc_import(
    name = "compiler_rt_builtins",
    static_library = "@llvm//runtimes/compiler-rt:clang_rt.builtins.static",
    visibility = ["//visibility:public"],
)

# rustdoc compiles examples as standalone programs. The hermetic Linux linker
# disables its implicit unwind library, so the doctest runfiles must carry and
# link the selected LLVM unwind archive explicitly.
cc_import(
    name = "llvm_unwind",
    static_library = "@llvm//runtimes/libunwind:libunwind.static",
    visibility = ["//visibility:public"],
)

rust_proc_macro(
    name = "doctest_path_mapper",
    crate_name = "rustleaks_doctest_path_mapper",
    crate_root = "doctest_path_mapper.rs",
    edition = "2024",
    srcs = ["doctest_path_mapper.rs"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "build_contract_files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
